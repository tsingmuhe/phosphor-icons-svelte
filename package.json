{
  "name": "@tsingmuhe/phosphor-icons-svelte",
  "version": "0.1.0",
  "description": "A phosphor icon library package for Svelte applications.",
  "type": "module",
  "author": {
    "name": "tsingmuhe",
    "email": "tsingmuhe@gmail.com"
  },
  "license": "MIT",
  "repository": "tsingmuhe/phosphor-icons-svelte",
  "sideEffects": false,
  "private": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "svelte": "./dist/icons/index.js",
      "import": "./dist/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.svelte.d.ts",
      "svelte": "./dist/icons/*.js",
      "import": "./dist/icons/*.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "svelte": "./dist/lib/index.js",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "svelte",
    "icons",
    "svg",
    "phosphor",
    "design",
    "interface",
    "UI",
    "UX"
  ],
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm run check && pnpm run test &&svelte-package --input ./src"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^27.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "svelte": "^5"
  }
}
